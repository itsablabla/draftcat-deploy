@@ -0,0 +1,60 @@
+package main
+
+// [hostim patch 0002] helpers for LLM-timeout resilience in the Hostim build.
+
+import (
+	"log"
+	"os"
+	"strconv"
+
+	"github.com/renezander030/draftcat/internal/config"
+	gmailapi "github.com/renezander030/draftcat/internal/gmail"
+	statestore "github.com/renezander030/draftcat/internal/state"
+)
+
+// aiTimeoutRetries is how many extra attempts an ai step gets after a call
+// exceeds timeouts.ai_call. DRAFTCAT_AI_TIMEOUT_RETRIES overrides (0 disables).
+func aiTimeoutRetries() int {
+	if v := os.Getenv("DRAFTCAT_AI_TIMEOUT_RETRIES"); v != "" {
+		if n, err := strconv.Atoi(v); err == nil && n >= 0 && n <= 5 {
+			return n
+		}
+	}
+	return 1
+}
+
+// timeoutUsageEstimate is the worst-case charge for a call abandoned at the
+// deadline: prompt at ~2 chars/token (over-estimate) plus the full max_tokens.
+func timeoutUsageEstimate(prompt string, maxTokens int, m config.ModelConfig) *CompletionResponse {
+	in := len(prompt)/2 + 1
+	cost := float64(in)/1000*m.CostIn + float64(maxTokens)/1000*m.CostOut
+	return &CompletionResponse{Model: m.Model, InputTokens: in, OutputTokens: maxTokens, CostUSD: cost, CostSource: "timeout-estimate"}
+}
+
+// filterUnseenEmails drops already-processed mail WITHOUT marking the rest
+// seen; it returns the new ids so the caller can mark them after success.
+func filterUnseenEmails(s *statestore.StateStore, pipeline string, emails []gmailapi.Email) ([]gmailapi.Email, []string) {
+	if s == nil || len(emails) == 0 {
+		return emails, nil
+	}
+	ids := make([]string, len(emails))
+	for i, e := range emails {
+		ids[i] = e.ID
+	}
+	unseen, err := s.FilterUnseen(pipeline, "gmail", ids)
+	if err != nil {
+		log.Printf("[state] FilterUnseen(%s/gmail) failed (proceeding without dedup): %v", pipeline, err)
+		return emails, ids
+	}
+	set := make(map[string]struct{}, len(unseen))
+	for _, id := range unseen {
+		set[id] = struct{}{}
+	}
+	out := make([]gmailapi.Email, 0, len(unseen))
+	for _, e := range emails {
+		if _, ok := set[e.ID]; ok {
+			out = append(out, e)
+		}
+	}
+	return out, unseen
+}
